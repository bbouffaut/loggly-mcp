# Required
LOGGLY_SUBDOMAIN=your_subdomain
LOGGLY_TOKEN=your_loggly_token

# Optional
LOGGLY_AUTH_MODE=bearer
LOGGLY_MAX_RETRIES=2
LOGGLY_REQUEST_TIMEOUT_MS=15000
LOGGLY_LOG_LEVEL=info

# Transport: stdio (default, local MCP clients) or http (Streamable HTTP,
# long-lived server for Kubernetes/remote use). In http mode the server
# listens on LOGGLY_MCP_PORT (default 8000) at the /mcp endpoint.
LOGGLY_MCP_TRANSPORT=stdio
LOGGLY_MCP_PORT=8000
